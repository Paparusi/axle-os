[Unit]
Description=Axle MCP cửa trước (127.0.0.1:8765): kiểm token, chuyển tới máy chủ riêng từng agent
After=network-online.target
Wants=network-online.target

[Service]
# User không quyền gì: chỉ đọc sổ token (root:axle-gw 0640) và nối socket agent (root:axle-gw 0660)
User=axle-gw
Group=axle-gw
ExecStart=/usr/bin/node /opt/axle/mcp/front.js
Environment=AXLE_MCP_HTTP_PORT=8765
Environment=AXLE_MCP_HTTP_HOST=127.0.0.1
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=256M

[Install]
WantedBy=multi-user.target
