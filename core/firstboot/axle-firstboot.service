[Unit]
Description=Axle — thiết lập lần đầu sau khi cài bằng ISO (cài Axle từ gói có chữ ký trong ISO)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/axle-installer/install.sh

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/bin/bash /opt/axle-installer/firstboot/firstboot.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
