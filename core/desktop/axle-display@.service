[Unit]
Description=Màn hình riêng của agent %i (Xvfb + cửa sổ, docs/DESKTOP.md D2)
After=local-fs.target

[Service]
User=ag-%i
Group=ag-%i
Environment=HOME=/home/ag-%i
RuntimeDirectory=axle-display-%i
Environment=XDG_RUNTIME_DIR=/run/axle-display-%i
# gọi qua bash: gói phát hành hay rsync có làm mất cờ thực thi thì dịch vụ vẫn chạy
ExecStart=/bin/bash /opt/axle/core/desktop/display-run.sh %i
Restart=on-failure
RestartSec=3

# /tmp KHÔNG riêng: socket X (/tmp/.X11-unix/X<n>) phải dùng chung với máy chủ MCP của chính agent này.
# Vé vào màn hình vẫn là cookie trong .Xauthority (0600) nên agent khác không nối ké được.
PrivateTmp=no
ProtectHome=tmpfs
BindPaths=/home/ag-%i
ProtectSystem=strict
# /tmp phải ghi được: máy chủ X tạo socket /tmp/.X11-unix/X<n> và khoá /tmp/.X<n>-lock ở đó
ReadWritePaths=/home/ag-%i /tmp
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=1500M
TasksMax=256
CPUQuota=150%

[Install]
WantedBy=multi-user.target
